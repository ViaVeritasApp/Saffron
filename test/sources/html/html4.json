{
    "url": [
        {
            "url": "http://127.0.0.1:3000/html4",
            "categories": ["Γενικές Ανακοινώσεις"]
        }
    ],
    "name": "html4-source",
    "parser": "html",
    "options": {
        "ignore_certificates": true,
        "encoding": "iso-8859-7"
    },
    "instructions": {
        "container": "#page-content > .news_container",
        "article": {
            "url": {
                "class": ".news_title",
                "find": ["a"],
                "attributes": ["href"],
                "multiple": false
            },
            "publication_date": {
                "class": ".news_date",
                "multiple": false
            },
            "title": {
                "class": ".news_title",
                "multiple": false
            },
            "content": {
                "class": ".news_main",
                "multiple": false
            },
            "attachments": {
                "class": ".news_main",
                "find": ["a"],
                "attributes": ["href"],
                "multiple": true
            }
        }
    }
}
