{
    "url": "http://127.0.0.1:3000/wp2/wp-json/wp/v2/articles",
    "name": "json1-source",
    "parser": "json",
    "options": {
        "articles": {
            "extract_attachments_from_content": false
        }
    },
    "instructions": {
        "container": [],
        "skip": [
            {"position": 5},
            {
                "find": ["title", "rendered"],
                "text": "Viohalco ESG Report (en)",
                "type": "exact"
            }
        ],
        "article": {
            "title": {
                "find": ["title", "rendered"]
            },
            "url": {
                "find": ["link"]
            },
            "publication_date": {
                "find": ["date_gmt"]
            },
            "content": {
                "find": ["content", "rendered"]
            },
            "thumbnail_url": {
                "find": ["_embedded", "wp:featuredmedia", 0, "media_details", "sizes", "thumbnail", "source_url"]
            }
        }
    }
}
